{
  "name": "ae-daily-plan",
  "version": "1.0.0",
  "private": true,
  "description": "An Agent Skill that builds an account executive's daily plan from Salesforce and Apollo, writes it with Claude, and delivers it in Slack.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {

    "demo": "node .claude/skills/ae-daily-plan/scripts/gather.ts --fixtures",
    "bot": "node bot/listen.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
